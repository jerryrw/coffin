# Historical build recipe retained as a reference; normal `make` uses Makefile.
# This predates automatic header dependencies, separate sanitizer builds, and
# current tests. Do not use its broad clean recipe for normal development.
# The active Makefile documents the supported build procedure.

TARGET = bin/coffin
SRC = $(wildcard src/*.c)
OBJ = $(patsubst src/%.c, obj/%.o, $(SRC))

default: $(TARGET)

clean:
	rm -f obj/*.o
	rm -f bin/*

$(TARGET): $(OBJ)
	gcc -o $@ $? -lm

obj/%.o : src/%.c
	gcc -c $< -o $@ -Iinclude
