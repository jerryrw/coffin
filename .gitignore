# Compiler and linker outputs
# Keep intentional executable fixtures through the explicit exceptions below.
*.com
*.class
*.dll
*.exe
*.o
*.d
*.a
*.lib
*.so
*.dylib

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Directories #
###############
# Ignore generated executables, logs/corpora, objects, and dependency files.
# Known-source root fixtures stay versioned so tests need no cross-compiler.
bin/
obj/

# Python test helpers
__pycache__/
*.py[cod]

# Intentional root-level PE test fixtures. Other generated .exe files stay ignored.
# Extensionless ELF/Mach-O fixtures are already visible without an exception.
!/testexecutable.exe
!/hello-pe32.exe
!/hello-pe64.exe

# Local release archives and checksum files generated by make package.
/dist/
