# Build roadmap for new C programmers:
#   make          Compile changed C files and link the inspector.
#   make test     Run the C unit tests and Python CLI regression suite.
#   make sanitize Build separately with runtime checks for invalid memory/UB.
#   make samples  Optionally cross-compile known-source executable fixtures.
# A target lists prerequisites after ':'. Indented recipe lines start with a TAB
# and are shell commands. Make rebuilds a target when prerequisites are newer.
# ?= supplies a default only if unset; += appends flags; = stores a variable.

CC ?= cc
# Homebrew LLVM includes libFuzzer, which some Apple Clang installs omit.
# Keep the system compiler for normal builds; FUZZ_CC can always override this.
ifeq ($(shell uname -s),Darwin)
FUZZ_CC ?= $(or $(firstword $(wildcard /opt/homebrew/opt/llvm/bin/clang /usr/local/opt/llvm/bin/clang)),clang)
else
FUZZ_CC ?= clang
endif
FUZZ_LDFLAGS ?=
# Some Linux systems have multiple GCC versions installed; Clang may pick one
# without a matching libstdc++ linker script. Add g++'s libstdc++ directory so
# -fsanitize=fuzzer can resolve its C++ runtime dependency reliably.
ifeq ($(shell uname -s),Linux)
FUZZ_STDCXX_SO := $(shell g++ -print-file-name=libstdc++.so 2>/dev/null)
ifneq ($(FUZZ_STDCXX_SO),libstdc++.so)
FUZZ_LDFLAGS += -L$(dir $(FUZZ_STDCXX_SO))
endif
endif
# Python drives regression tests, fixtures, and fuzz orchestration. CPPFLAGS
# are preprocessor options; -Iinclude lets #include find project headers.
PYTHON ?= python3
VERSION := $(shell cat VERSION)
CPPFLAGS += -Iinclude -DCOFFIN_VERSION=\"$(VERSION)\"
# CFLAGS control compilation: optimization/debug info, C11 language rules,
# and useful warnings. LDFLAGS control linking; LDLIBS supply library dependencies.
CFLAGS ?= -O2 -g
CFLAGS += -std=c11 -Wall -Wextra -Wpedantic
# The math library provides log2 for entropy. macOS also needs a separate iconv
# library for resource text conversion; typical Linux libc supplies iconv itself.
LDLIBS += -lm
ifeq ($(shell uname -s),Darwin)
LDLIBS += -liconv
endif
# Directory overrides keep sanitizer and normal object files from mixing.
# A .o file is compiled machine code awaiting the final link step.
BUILD_DIR ?= obj
BIN_DIR ?= bin
TARGET = $(BIN_DIR)/coffin
# DESTDIR stages an installation without requiring writes to system directories.
PREFIX ?= /usr/local
BINDIR ?= $(PREFIX)/bin
DOCDIR ?= $(PREFIX)/share/doc/coffin
INSTALL ?= install
# wildcard finds source files. patsubst maps src/name.c to BUILD_DIR/name.o.
# .d files record which headers each object depends on; LIBSRC omits CLI main
# so test/fuzz programs can supply their own entry point.
SRC = $(wildcard src/*.c)
OBJ = $(patsubst src/%.c,$(BUILD_DIR)/%.o,$(SRC))
DEP = $(OBJ:.o=.d)
LIBSRC = $(filter-out src/main.c,$(SRC))

# Phony targets are actions, not expected output files. "all" is the default
# action because it is the first ordinary target in this Makefile.
.PHONY: all default clean test sanitize fuzz fuzz-smoke samples differential install uninstall package valgrind leaks memory-check
all: $(TARGET)
default: all

# Link all object files into one executable. $@ is the current target, and
# $(OBJ) lists every object, including unchanged ones needed for linking.
# Prerequisites after | are order-only: create the directory if necessary,
# but its timestamp alone must not force relinking.
$(TARGET): $(OBJ) | $(BIN_DIR)
	$(CC) $(LDFLAGS) -o $@ $(OBJ) $(LDLIBS)

# Directory targets share one recipe. mkdir -p succeeds when already present.
$(BUILD_DIR) $(BIN_DIR):
	mkdir -p $@

# Pattern rule: % stands for the same filename stem in source and target.
# $< is the first prerequisite. -MMD -MP emits header dependency files; -c
# compiles without linking. Editing a header then rebuilds its dependent objects.
$(BUILD_DIR)/%.o: src/%.c Makefile VERSION | $(BUILD_DIR)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

# The leading minus allows missing .d files on a fresh checkout. They will
# be generated by compilation rather than requiring a separate dependency step.
-include $(DEP)

# Optional cross-compilation; ordinary tests use the checked-in executable fixtures.
samples:
	$(PYTHON) tests/build_samples.py $(SAMPLE_ARGS)

# Each unit test has its own main, so exclude the inspector main.o.
# $^ expands all normal prerequisites; here they are source plus linkable objects.
$(BIN_DIR)/test-entropy: tests/test_entropy.c $(filter-out $(BUILD_DIR)/main.o,$(OBJ)) | $(BIN_DIR)
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $@ $^ $(LDLIBS)

# Hash tests only need the two hash implementations, not all parsers.
$(BIN_DIR)/test-hashes: tests/test_hashes.c $(BUILD_DIR)/md5.o $(BUILD_DIR)/sha256.o | $(BIN_DIR)
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $@ $^ $(LDLIBS)

# Make stops on a failing recipe, so any failed unit/CLI test fails this target.
# Keep assertions enabled in test builds (do not define NDEBUG).
$(BIN_DIR)/test-display: tests/test_display.c $(BUILD_DIR)/common.o $(BUILD_DIR)/md5.o $(BUILD_DIR)/sha256.o | $(BIN_DIR)
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $@ $^ $(LDLIBS)

$(BIN_DIR)/test-limits: tests/test_limits.c $(BUILD_DIR)/common.o $(BUILD_DIR)/md5.o $(BUILD_DIR)/sha256.o | $(BIN_DIR)
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $@ $^ $(LDLIBS)

test: $(TARGET) $(BIN_DIR)/test-entropy $(BIN_DIR)/test-hashes $(BIN_DIR)/test-display $(BIN_DIR)/test-limits
	$(BIN_DIR)/test-entropy
	$(BIN_DIR)/test-hashes
	$(BIN_DIR)/test-display
	$(BIN_DIR)/test-limits
	$(PYTHON) tests/test_malformed.py $(TARGET)
	$(PYTHON) tests/test_distribution.py $(TARGET)
	$(PYTHON) tests/test_corpus.py $(TARGET)
	$(PYTHON) tests/test_parser_limits.py $(TARGET)

# Recursive $(MAKE) builds into separate directories. ASan detects many invalid
# memory accesses; UBSan checks undefined operations. -Werror also makes compiler
# warnings fail the build, and frame pointers improve diagnostic stack traces.
sanitize:
	$(MAKE) BUILD_DIR=obj/sanitize BIN_DIR=bin/sanitize CFLAGS='-O1 -g -std=c11 -Wall -Wextra -Wpedantic -Werror -fsanitize=address,undefined -fno-omit-frame-pointer' LDFLAGS='-fsanitize=address,undefined' test

# Use ordinary debug binaries: Valgrind and Apple's leaks must not be mixed
# with ASan's replacement allocator. Run functional tests before memory checks.
VALGRIND ?= valgrind
LEAKS ?= leaks
MEMORY_CFLAGS = -O1 -g -std=c11 -Wall -Wextra -Wpedantic -fno-omit-frame-pointer

$(BIN_DIR)/memory-probe: tests/memory_probe.c | $(BIN_DIR)
	$(CC) -O0 -g -o $@ $<

valgrind:
	@test "$$(uname -s)" = Linux || { echo 'Use make leaks on macOS.' >&2; exit 1; }
	@command -v "$(VALGRIND)" >/dev/null || { echo 'Install Valgrind first (Debian/Ubuntu: sudo apt-get install valgrind).' >&2; exit 1; }
	$(MAKE) BUILD_DIR=obj/valgrind BIN_DIR=bin/valgrind CFLAGS='$(MEMORY_CFLAGS)' LDFLAGS='' test bin/valgrind/memory-probe
	$(PYTHON) tests/run_memory_checks.py valgrind bin/valgrind --checker "$(VALGRIND)"

leaks:
	@test "$$(uname -s)" = Darwin || { echo 'Use make valgrind on Linux.' >&2; exit 1; }
	@command -v "$(LEAKS)" >/dev/null || { echo 'Apple leaks tool is missing.' >&2; exit 1; }
	$(MAKE) BUILD_DIR=obj/leaks BIN_DIR=bin/leaks CFLAGS='$(MEMORY_CFLAGS)' LDFLAGS='' test bin/leaks/memory-probe
	$(PYTHON) tests/run_memory_checks.py leaks bin/leaks --checker "$(LEAKS)"

# Convenient platform selection; these checks remain opt-in for ordinary builds.
memory-check:
ifeq ($(shell uname -s),Darwin)
	$(MAKE) leaks
else
	$(MAKE) valgrind
endif

bin/fuzz:
	mkdir -p $@

# libFuzzer supplies main and calls LLVMFuzzerTestOneInput in the harness.
# Compile the harness and library sources together with fuzz coverage and memory
# checks. The shell fallback prints toolchain help and preserves a failed status.
bin/fuzz/coffin-fuzz: tests/fuzz_parser.c $(LIBSRC) $(wildcard include/*.h) Makefile | bin/fuzz
	$(FUZZ_CC) $(CPPFLAGS) -std=c11 -O1 -g -Wall -Wextra -Wpedantic -Werror -fsanitize=fuzzer,address,undefined -fno-omit-frame-pointer $(FUZZ_LDFLAGS) $(LIBSRC) tests/fuzz_parser.c $(LDLIBS) -o $@ || { \
		if [ "$$(uname -s)" = Darwin ]; then \
			echo 'Fuzzer build failed. If libFuzzer is missing, install Homebrew LLVM: brew install llvm' >&2; \
			echo 'Then run: make FUZZ_CC="$$(brew --prefix llvm)/bin/clang" fuzz' >&2; \
		elif [ "$$(uname -s)" = Linux ]; then \
			echo 'Fuzzer build failed. libFuzzer links C++ runtime libraries.' >&2; \
			echo 'If the error mentions -lstdc++, install the GNU C++ runtime development package.' >&2; \
			echo 'Debian/Ubuntu: sudo apt-get install g++' >&2; \
			echo 'Fedora/RHEL:  sudo dnf install gcc-c++' >&2; \
			echo 'If this still fails, pass the library dir explicitly, e.g. FUZZ_LDFLAGS="-L$$(dirname "$$(g++ -print-file-name=libstdc++.so)")".' >&2; \
		fi; \
		exit 1; \
	}

fuzz: bin/fuzz/coffin-fuzz

# This variant defines STANDALONE_FUZZ so the same harness supplies its own main
# and deterministic mutations; it works without the libFuzzer runtime.
bin/fuzz/coffin-smoke: tests/fuzz_parser.c $(LIBSRC) $(wildcard include/*.h) Makefile | bin/fuzz
	$(CC) $(CPPFLAGS) -DSTANDALONE_FUZZ -std=c11 -O1 -g -Wall -Wextra -Wpedantic -Werror -fsanitize=address,undefined -fno-omit-frame-pointer $(LIBSRC) tests/fuzz_parser.c $(LDLIBS) -o $@

# @ hides the recipe text, not its output. Redirect verbose fuzz diagnostics
# to a log; on failure print its tail and return failure instead of hiding it.
# The seed generator runs first so synthetic formats join the checked-in samples.
fuzz-smoke: bin/fuzz/coffin-smoke
	$(PYTHON) tests/fixtures.py bin/fuzz/seeds
	@bin/fuzz/coffin-smoke testexecutable.exe testelf testmach hello-* bin/fuzz/seeds/* > bin/fuzz/smoke.log 2>&1 || { tail -60 bin/fuzz/smoke.log; exit 1; }
	@tail -1 bin/fuzz/smoke.log

# Remove only the selected build outputs. Normal and sanitizer directories
# are separate; override BUILD_DIR/BIN_DIR to clean the sanitizer build too.
clean:
	rm -f $(OBJ) $(DEP) $(TARGET) $(BIN_DIR)/test-entropy $(BIN_DIR)/test-hashes $(BIN_DIR)/test-display $(BIN_DIR)/test-limits $(BIN_DIR)/memory-probe

# Independent tools are optional locally; CI specifies which tools must exist.
differential: $(TARGET)
	$(PYTHON) tests/test_differential_parser.py
	$(PYTHON) tests/test_differential.py $(TARGET) $(DIFFERENTIAL_ARGS)

install: $(TARGET)
	$(INSTALL) -d "$(DESTDIR)$(BINDIR)" "$(DESTDIR)$(DOCDIR)"
	$(INSTALL) -m 755 $(TARGET) "$(DESTDIR)$(BINDIR)/coffin"
	$(INSTALL) -m 644 README.md License CHANGELOG.md VERSION "$(DESTDIR)$(DOCDIR)/"

# Remove only files installed by this target, leaving shared directories alone.
uninstall:
	rm -f "$(DESTDIR)$(BINDIR)/coffin"
	rm -f "$(DESTDIR)$(DOCDIR)/README.md" "$(DESTDIR)$(DOCDIR)/License" "$(DESTDIR)$(DOCDIR)/CHANGELOG.md" "$(DESTDIR)$(DOCDIR)/VERSION"

package: $(TARGET)
	$(PYTHON) scripts/package_release.py $(TARGET)
